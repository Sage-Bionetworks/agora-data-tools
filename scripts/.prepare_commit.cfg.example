# Developer-local config for prepare_commit.py
#
# Copy this file to scripts/.prepare_commit.cfg (gitignored) and fill in your
# own values. Once set, you can run the script with no arguments:
#
#   python scripts/prepare_commit.py
#
# Supported package managers: conda, venv, virtualenv, poetry, pipenv

[defaults]
# Your package manager (conda, venv, virtualenv, poetry, or pipenv)
package_manager = conda

# The name of your virtual environment
# - conda/venv/virtualenv: the environment name (e.g. adt_py310, .venv)
# - poetry/pipenv: the project name used in the generated env folder
env_name = adt_py310
