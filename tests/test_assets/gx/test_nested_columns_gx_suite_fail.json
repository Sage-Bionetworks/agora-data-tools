{
  "data_asset_type": null,
  "expectation_suite_name": "test_nested_columns",
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_be_of_type",
      "kwargs": {
        "column": "table_id",
        "type_": "str"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "table_id"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "table_id",
        "regex": "^TABLE_[A-Z_]+$"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_string_length",
      "kwargs": {
        "column": "columns",
        "length_threshold": 20,
        "operator": ">",
        "target_field": "tooltip",
        "valid_threshold": 0.9
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_not_null",
      "kwargs": {
        "column": "columns",
        "non_null_threshold": 0.9,
        "target_field": "tooltip"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_regex_rule",
      "kwargs": {
        "column": "columns",
        "regex_pattern": "^[A-Z_]+$",
        "target_field": "data_key",
        "valid_threshold": 0.9
      },
      "meta": {}
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.1"
  }
