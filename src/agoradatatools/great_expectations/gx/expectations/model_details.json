    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "genetic_info"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_match_json_schema",
      "kwargs": {
        "column": "genetic_info",
        "json_schema": {
          "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/model_details/genetic_info_schema.json",
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "items": {
            "additionalProperties": true,
            "properties": {
              "allele": {
                "minLength": 1,
                "type": "string"
              },
              "allele_type": {
                "enum": [
                  "Transgenic",
                  "Targeted",
                  "Endonuclease-mediated"
                ],
                "type": "string"
              },
              "ensembl_gene_id": {
                "pattern": "^ENS(MUS)?G[0-9]{11}$",
                "type": "string"
              },
              "ensembl_info": {
                "additionalProperties": false,
                "properties": {
                  "ensembl_permalink": {
                    "format": "uri",
                    "pattern": "^https://\\w+\\.archive\\.ensembl\\.org/.*/Gene/Summary\\?db=core;g=ENS(MUS)?G[0-9]{11}$",
                    "type": "string"
                  },
                  "ensembl_possible_replacements": {
                    "items": {
                      "pattern": "^ENS(MUS)?G[0-9]{11}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "ensembl_release": {
                    "maxLength": 3,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ensembl_release",
                  "ensembl_possible_replacements",
                  "ensembl_permalink"
                ],
                "type": "object"
              },
              "mgi_allele_id": {
                "type": "integer"
              },
              "modified_gene": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "modified_gene",
              "ensembl_gene_id",
              "allele",
              "allele_type",
              "mgi_allele_id",
              "ensembl_info"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "meta": {}
    },
