    {
      "expectation_type": "expect_column_values_to_match_json_schema",
      "kwargs": {
        "column": "target_nominations",
        "json_schema": {
          "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/gene_info/target_nominations.json",
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "default": [],
          "items": {
            "default": {},
            "properties": {
              "data_synapseid": {
                "maxLength": 25,
                "minLength": 4,
                "pattern": "^syn\\d+$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "data_used_to_support_target_selection": {
                "maxLength": 2000,
                "minLength": 15,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "hgnc_symbol": {
                "maxLength": 25,
                "minLength": 2,
                "type": "string"
              },
              "initial_nomination": {
                "minimum": 2018,
                "type": "integer"
              },
              "input_data": {
                "maxLength": 200,
                "minLength": 2,
                "type": "string"
              },
              "predicted_therapeutic_direction": {
                "maxLength": 2000,
                "minLength": 2,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$",
                "type": "string"
              },
              "rank": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "enum": [
                  "Community",
                  "AMP-AD",
                  "Resilience-AD",
                  "TREAT-AD",
                  "FunGen-AD"
                ],
                "type": "string"
              },
              "study": {
                "maxLength": 500,
                "minLength": 2,
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_choice_justification": {
                "maxLength": 3000,
                "minLength": 2,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$",
                "type": "string"
              },
              "team": {
                "maxLength": 50,
                "minLength": 3,
                "type": "string"
              },
              "validation_study_details": {
                "maxLength": 1000,
                "minLength": 0,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "source",
              "team",
              "rank",
              "hgnc_symbol",
              "target_choice_justification",
              "predicted_therapeutic_direction",
              "data_used_to_support_target_selection",
              "data_synapseid",
              "study",
              "input_data",
              "validation_study_details",
              "initial_nomination"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Target Nominations Schema",
          "type": [
            "array",
            "null"
          ]
        }
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_not_null",
      "kwargs": {
        "column": "target_nominations",
        "non_null_threshold": 0.85,
        "target_field": "validation_study_details"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_string_length",
      "kwargs": {
        "column": "target_nominations",
        "length_threshold": 0,
        "operator": ">",
        "target_field": "data_used_to_support_target_selection",
        "valid_threshold": 0.95
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_nested_object_regex_rule",
      "kwargs": {
        "column": "target_nominations",
        "regex_pattern": "^syn[0-9]+$",
        "target_field": "data_synapseid",
        "valid_threshold": 0.7
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_match_json_schema",
