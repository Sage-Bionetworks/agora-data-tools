            },
            "required": [
              "min",
              "first_quartile",
              "median",
              "mean",
              "third_quartile",
              "max",
              "tissue"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "minItems": 2,
          "title": "Median Expression Schema",
          "type": [
            "array",
            "null"
          ]
        },
        "mostly": 0.95
