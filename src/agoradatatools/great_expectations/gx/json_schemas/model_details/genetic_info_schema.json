{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/model_details/genetic_info_schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "modified_gene": { "type": "string", "minLength": 1 },
      "ensembl_gene_id": { "type": "string", "pattern": "^ENS(MUS)?G[0-9]{11}$" },
      "allele": { "type": "string", "minLength": 1 },
      "allele_type": {
        "type": "string",
        "enum": ["Transgenic", "Targeted", "Endonuclease-mediated"]
      },
      "mgi_allele_id": { "type": "integer" },
      "ensembl_info": {
        "type": "object",
        "properties": {
          "ensembl_release": { "type": "string", "minLength": 1, "maxLength": 3 },
          "ensembl_possible_replacements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ENS(MUS)?G[0-9]{11}$" }
          },
          "ensembl_permalink": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\/\/\\w+\\.archive\\.ensembl\\.org\/.*\/Gene\/Summary\\?db=core;g=ENS(MUS)?G[0-9]{11}$"
          }
        },
        "required": ["ensembl_release", "ensembl_possible_replacements", "ensembl_permalink"],
        "additionalProperties": false
      }
    },
    "required": [
      "modified_gene",
      "ensembl_gene_id",
      "allele",
      "allele_type",
      "mgi_allele_id",
      "ensembl_info"
    ],
    "additionalProperties": true
  }
}
