{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/gene_info/median_expression.json",
    "type": ["array", "null"],
    "default": [],
    "title": "Median Expression Schema",
    "minItems": 2,
    "maxItems": 9,
    "items": {
        "type": "object",
        "required": [
            "min",
            "first_quartile",
            "median",
            "mean",
            "third_quartile",
            "max",
            "tissue"
        ],
        "properties": {
            "min": {
                "type": "number",
                "minimum": -8,
                "maximum": 14
            },
            "first_quartile": {
                "type": "number",
                "minimum": -7,
                "maximum": 15
            },
            "median": {
                "type": "number",
                "minimum": -7,
                "maximum": 15
            },
            "mean": {
                "type": "number",
                "minimum": -7,
                "maximum": 15
            },
            "third_quartile": {
                "type": "number",
                "minimum": -7,
                "maximum": 15
            },
            "max": {
                "type": "number",
                "minimum": -5,
                "maximum": 15
            },
            "tissue": {
                "type": "string",
                "enum": [
                    "CBE",
                    "TCX",
                    "ACC",
                    "DLPFC",
                    "PCC",
                    "FP",
                    "IFG",
                    "PHG",
                    "STG"
                ]
            }
        }
    }
}
