{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/gene_info/target_nominations.json",
    "type": ["array", "null"],
    "default": [],
    "title": "Target Nominations Schema",
    "minItems": 1,
    "maxItems": 10,
    "items": {
        "type": "object",
        "default": {},
        "required": [
            "source",
            "team",
            "rank",
            "hgnc_symbol",
            "target_choice_justification",
            "predicted_therapeutic_direction",
            "data_used_to_support_target_selection",
            "data_synapseid",
            "study",
            "input_data",
            "validation_study_details",
            "initial_nomination"
        ],
        "properties": {
            "source": {
                "type": "string",
                "enum": ["Community", "AMP-AD", "Resilience-AD", "TREAT-AD", "FunGen-AD"]
            },
            "team": {
                "type": "string",
                "minLength": 3,
                "maxLength": 50
            },
            "rank": {
                "type": ["string", "null"]
            },
            "hgnc_symbol": {
                "type": "string",
                "minLength": 2,
                "maxLength": 25
            },
            "target_choice_justification": {
                "type": "string",
                "minLength": 2,
                "maxLength": 3000,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$"
            },
            "predicted_therapeutic_direction": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2000,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$"
            },
            "data_used_to_support_target_selection": {
                "type": ["string", "null"],
                "minLength": 15,
                "maxLength": 2000,
                "pattern": "^(?:(?![\ufffd]).|[\r\n])*(?<![\r\n])$"
            },
            "data_synapseid": {
                "type": ["string", "null"],
                "minLength": 4,
                "maxLength": 25,
                "pattern": "^syn\\d+$"
            },
            "study": {
                "type": ["string", "null"],
                "minLength": 2,
                "maxLength": 500
            },
            "input_data": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200
            },
            "validation_study_details": {
                "type": ["string", "null"],
                "minLength": 0,
                "maxLength": 1000
            },
            "initial_nomination": {
                "type": "integer",
                "minimum": 2018
            }
        }
    }
}
