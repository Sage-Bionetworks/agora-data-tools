{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/gene_info/ensembl_info.json",
    "type": "object",
    "default": {},
    "title": "Ensembl Info Schema",
    "required": [
        "ensembl_release",
        "ensembl_possible_replacements",
        "ensembl_permalink"
    ],
    "properties": {
        "ensembl_release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^\\d+$"
        },
        "ensembl_possible_replacements": {
            "type": "array",
            "maxItems": 5,
            "items": {
                "type": "string",
                "pattern": "^ENSG[0-9]{11}$"
            }
        },
        "ensembl_permalink": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\/\/\\w+\\.archive\\.ensembl\\.org\/Homo_sapiens\/Gene\/Summary\\?db=core\\;g=(ENSG[0-9]+)$"
        }
    }
}
