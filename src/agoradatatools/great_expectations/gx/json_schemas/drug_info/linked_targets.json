{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/Sage-Bionetworks/agora-data-tools/src/agoradatatools/great_expectations/gx/json_schemas/drug_info/linked_targets.json",
    "title": "Drug Info Linked Targets Schema",
    "type": "array",
    "minItems": 0,
    "maxItems": 100,
    "items": {
        "type": "object",
        "properties": {
            "ensembl_gene_id": {
                "type": "string",
                "pattern": "^ENSG[0-9]{11}$"
            },
            "hgnc_symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
            },
            "is_nominated_target": {
                "type": "boolean"
            }
        },
        "required": [
            "ensembl_gene_id",
            "hgnc_symbol",
            "is_nominated_target"
        ],
        "additionalProperties": false
    }
}
