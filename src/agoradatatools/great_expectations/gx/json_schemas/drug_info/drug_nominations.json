{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "title": "Drug Info Drug Nominations Schema",
    "type": "array",
    "minItems": 1,
    "maxItems": 50,
    "items": {
        "type": "object",
        "properties": {
            "grant_number": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
            },
            "contact_pi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
            },
            "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
            },
            "data_used": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
            },
            "ad_moa": {
                "type": ["string", "null"],
                "maxLength": 2000
            },
            "reference": {
                "type": ["string", "null"],
                "maxLength": 1000
            },
            "computational_validation_status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            },
            "computational_validation_results": {
                "type": ["string", "null"],
                "maxLength": 2000
            },
            "experimental_validation_status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            },
            "experimental_validation_results": {
                "type": ["string", "null"],
                "maxLength": 2000
            },
            "additional_evidence": {
                "type": ["string", "null"],
                "maxLength": 2000
            },
            "contributors": {
                "type": ["string", "null"],
                "maxLength": 1000
            },
            "initial_nomination": {
                "type": "integer",
                "minimum": 2025,
                "maximum": 2050
            },
            "program": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
            },
            "combined_with": {
                "type": "array",
                "minItems": 0,
                "maxItems": 10,
                "items": {
                    "type": "object",
                    "properties": {
                        "common_name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        "chembl_id": {
                            "type": "string",
                            "pattern": "^CHEMBL\\d+$"
                        }
                    },
                    "required": [
                        "common_name",
                        "chembl_id"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "required": [
            "grant_number",
            "contact_pi",
            "evidence",
            "data_used",
            "ad_moa",
            "reference",
            "computational_validation_status",
            "computational_validation_results",
            "experimental_validation_status",
            "experimental_validation_results",
            "additional_evidence",
            "contributors",
            "initial_nomination",
            "program",
            "combined_with"
        ],
        "additionalProperties": false
    }
}
